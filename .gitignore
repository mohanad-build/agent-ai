node_modules/
.env

# OAuth credentials (Google client secret JSON)
client_secret_*.json
credentials.json
token.json

# Agent refresh tokens (per-agent OAuth tokens)
agents/*.json
!agents/.gitkeep
!agents/example.json

# Agent state files (runtime state, not committed)
agents/*.state.json

# Operator runtime configs (per-operator OAuth tokens)
operators/*.json
!operators/example.json

# Operator state files (runtime state, not committed)
operators/*.state.json

# OS / editor noise
.DS_Store
*.log
.vscode/
.idea/

# Content Engine data cache (runtime data, do not commit)
data/market/**/*.json
data/market/**/*.jsonl
!data/market/.gitkeep

# HARD GATE 7 calibration baselines (local working evidence, recreated via scripts/calibration-7-11-8.js)
calibration-archive/

# HARD GATE follow-up/path1a prompt iteration baselines (local working evidence, recreated via scripts/iterate-prompts.js)
prompt-iteration-archive/
agents/

# Session store (CASA 2.2.1): encrypted session files written under
# STORAGE_ROOT/_sessions by src/sessionStore.js. No leading slash, so this
# matches at any depth -- covers STORAGE_ROOT defaulting to repo root
# (process.cwd(), see storagePaths.js) as well as STORAGE_ROOT=agents/ in
# local dev. Not relying on the agents/ rule above: that only happens to
# cover this because of this developer's specific STORAGE_ROOT value, not
# because it was meant to.
_sessions/
casa-evidence/
